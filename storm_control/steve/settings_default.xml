<?xml version="1.0" encoding="ISO-8859-1"?>
<settings>

  <!-- general -->
  <debug type="int">1</debug>
  <use_as_default type="int">1</use_as_default>
  <extrapolate_picture_count type="int">9</extrapolate_picture_count>

  <!-- capture -->
  <directory type="string">c:\data\</directory>
  <image_filename type="string">steve</image_filename>

  <!-- position rectangles & section circles -->
  <rectangle_size type="float">43.0</rectangle_size>
  <ellipse_size type="float">3</ellipse_size>
  <pen_width type="int">20</pen_width>
  <step_size type="float">5</step_size>

  <!-- Dave -> Steve FOV markers. fov_marker_size_um is a placeholder;
       set it to the actual camera FOV size (in microns) for the
       objective in use on this microscope. -->
  <fov_marker_port type="int">9600</fov_marker_port>
  <fov_marker_size_um type="float">200.0</fov_marker_size_um>

</settings>
